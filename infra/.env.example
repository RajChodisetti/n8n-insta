# Local stack ports.
# These defaults were chosen from currently free high ports to reduce collisions
# with other local Postgres/Redis/MinIO instances.
N8N_HOST_PORT=35678
POSTGRES_HOST_PORT=36432
REDIS_HOST_PORT=36379
MINIO_API_HOST_PORT=39000
MINIO_CONSOLE_HOST_PORT=42173

# n8n runtime config
N8N_PROTOCOL=http
N8N_HOST=localhost
N8N_EDITOR_BASE_URL=http://localhost:35678
WEBHOOK_URL=http://localhost:35678
GENERIC_TIMEZONE=America/Phoenix

# Internal service credentials for local development only.
POSTGRES_DB=n8n_insta
POSTGRES_USER=n8n_insta
POSTGRES_PASSWORD=change-me-postgres
REDIS_PASSWORD=change-me-redis
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=instagram-reels

# n8n app secrets
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-n8n

# Local Phase 2 OpenAI workflows currently execute more reliably inline than
# through the 1.92.2 task-runner path.
N8N_RUNNERS_ENABLED=false

# Code-first pipeline worker runtime.
PIPELINE_WORKER_POLL_MS=5000
PIPELINE_STALE_RUNNING_SECONDS=900
DEFAULT_REEL_TYPE=video
RENDER_PROVIDER=remotion
RENDER_WORKER_SYNC_URL=http://remotion-renderer:8081/render-sync
FFMPEG_RENDER_FALLBACK_ENABLED=false
REMOTION_RENDER_STUB=false
ALLOW_VIDEO_TO_IMAGE_FALLBACK=false
STUDIO_TOPIC_TARGET_DURATION_MIN_SECONDS=15
STUDIO_TOPIC_TARGET_DURATION_MAX_SECONDS=180
STUDIO_TOPIC_TARGET_DURATION_DEFAULT_SECONDS=80
INSTAGRAM_REEL_MAX_SECONDS=80

# HeyGen avatar runtime. Leave blank unless avatar reel generation is enabled
# and explicit avatar consent/account policy metadata exists on the content item.
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
HEYGEN_CALLBACK_URL=
HEYGEN_POLL_INTERVAL_SECONDS=10
HEYGEN_TIMEOUT_SECONDS=900
STUDIO_AVATAR_ALLOWED=false
STUDIO_AVATAR_CONSENT_STATUS=
HEYGEN_AVATAR_CONSENT_RECORD_URI=
HEYGEN_MOCK_COMPLETED_URL=
HEYGEN_MOCK_THUMBNAIL_URL=
HEYGEN_MOCK_DURATION_SECONDS=

# Root project secrets are loaded from the repo-root `.env` via `../.env`.
# Do not re-declare `INSTAGRAM_GRAPH_API_TOKEN` here, or a blank value will
# override the real token inside the running n8n container.
