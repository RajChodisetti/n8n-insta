    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select\n  ci.content_id,\n  ci.slug,\n  ci.title,\n  ci.status as content_status,\n  p.publish_status,\n  p.instagram_media_id,\n  p.instagram_container_id,\n  p.published_at,\n  r.output_video_url\nfrom content_items ci\njoin publishes p on p.content_id = ci.content_id\nleft join renders r on r.content_id = ci.content_id\nwhere p.platform = 'instagram'\n  and p.publish_status = 'published'\norder by coalesce(p.published_at, ci.updated_at) desc\nlimit 1;",
