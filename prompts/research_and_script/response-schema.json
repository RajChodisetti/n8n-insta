{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "confidence_label",
    "hook_option_1",
    "hook_option_2",
    "hook_option_3",
    "selected_hook",
    "narration_script",
    "short_script",
    "caption_draft",
    "cta_line",
    "onscreen_text_json",
    "music_direction",
    "scene_guidance_json"
  ],
  "properties": {
    "confidence_label": {
      "type": "string",
      "enum": ["confirmed", "likely", "disputed", "legend", "unverified"]
    },
    "hook_option_1": {
      "type": "string",
      "minLength": 1
    },
    "hook_option_2": {
      "type": "string",
      "minLength": 1
    },
    "hook_option_3": {
      "type": "string",
      "minLength": 1
    },
    "selected_hook": {
      "type": "string",
      "minLength": 1
    },
    "narration_script": {
      "type": "string",
      "minLength": 1
    },
    "short_script": {
      "type": "string",
      "minLength": 1
    },
    "caption_draft": {
      "type": "string",
      "minLength": 1
    },
    "cta_line": {
      "type": "string",
      "minLength": 1
    },
    "music_direction": {
      "type": "string",
      "minLength": 1
    },
    "onscreen_text_json": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scene_number", "text"],
        "properties": {
          "scene_number": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scene_guidance_json": {
      "type": "array",
      "minItems": 4,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scene_number",
          "beat_label",
          "start_time_seconds",
          "end_time_seconds",
          "duration_seconds",
          "narration_text",
          "dialogue_lines",
          "asset_type",
          "scene_purpose",
          "visual_beat",
          "source_boundary",
          "music_cue"
        ],
        "properties": {
          "scene_number": {
            "type": "integer",
            "minimum": 1
          },
          "beat_label": {
            "type": "string",
            "minLength": 1
          },
          "start_time_seconds": {
            "type": "number",
            "minimum": 0
          },
          "end_time_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "narration_text": {
            "type": "string",
            "minLength": 1
          },
          "dialogue_lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "asset_type": {
            "type": "string",
            "enum": ["image", "video"]
          },
          "scene_purpose": {
            "type": "string",
            "minLength": 1
          },
          "visual_beat": {
            "type": "string",
            "minLength": 1
          },
          "source_boundary": {
            "type": "string",
            "minLength": 1
          },
          "music_cue": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
