{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "storyboard_json",
    "cover_prompt",
    "subtitle_lines_json",
    "style_notes",
    "visual_style_summary",
    "render_manifest_seed_json"
  ],
  "properties": {
    "storyboard_json": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scene_number",
          "duration_seconds",
          "narration_text",
          "dialogue_lines",
          "tts_instructions",
          "visual_prompt",
          "asset_type",
          "transition",
          "mood",
          "music_cue",
          "is_face_image",
          "face_image_title"
        ],
        "properties": {
          "scene_number": {
            "type": "integer",
            "minimum": 1
          },
          "duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "narration_text": {
            "type": "string",
            "minLength": 1
          },
          "dialogue_lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "tts_instructions": {
            "type": "string",
            "minLength": 1
          },
          "visual_prompt": {
            "type": "string",
            "minLength": 1
          },
          "asset_type": {
            "type": "string",
            "enum": ["image", "video"]
          },
          "transition": {
            "type": "string",
            "minLength": 1
          },
          "mood": {
            "type": "string",
            "minLength": 1
          },
          "music_cue": {
            "type": "string",
            "minLength": 1
          },
          "is_face_image": {
            "type": "boolean",
            "description": "True if this is the opening face image that receives a renderer title overlay"
          },
          "face_image_title": {
            "type": "string",
            "description": "Short title text (2-5 words) for scene 1 renderer overlay. Use an empty string for all other scenes. Do not include this text inside the generated image prompt."
          }
        }
      }
    },
    "cover_prompt": {
      "type": "string",
      "minLength": 1
    },
    "subtitle_lines_json": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scene_number", "text"],
        "properties": {
          "scene_number": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "style_notes": {
      "type": "string",
      "minLength": 1
    },
    "visual_style_summary": {
      "type": "string",
      "minLength": 1
    },
    "render_manifest_seed_json": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output", "timeline", "subtitles"],
      "properties": {
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height", "fps", "format"],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "fps": {
              "type": "integer",
              "minimum": 1
            },
            "format": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "timeline": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scene_number", "duration_seconds", "asset_type", "transition"],
            "properties": {
              "scene_number": {
                "type": "integer",
                "minimum": 1
              },
              "duration_seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "asset_type": {
                "type": "string",
                "enum": ["image", "video"]
              },
              "transition": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "subtitles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "style"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "style": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
