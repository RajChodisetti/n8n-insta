{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "categories",
    "tags",
    "moods",
    "vocals",
    "license",
    "license_status",
    "publish_allowed",
    "license_scope",
    "allowed_uses",
    "disallowed_uses",
    "url"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "relative_path": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "minLength": 1
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "moods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "vocals": {
      "type": "boolean"
    },
    "volume": {
      "type": "number",
      "minimum": 0
    },
    "fade_in_seconds": {
      "type": "number",
      "minimum": 0
    },
    "fade_out_seconds": {
      "type": "number",
      "minimum": 0
    },
    "default": {
      "type": "boolean"
    },
    "enabled": {
      "type": "boolean"
    },
    "source_provider": {
      "type": "string",
      "minLength": 1
    },
    "source_page_url": {
      "type": "string",
      "minLength": 1
    },
    "source_asset_url": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "license_url": {
      "type": "string",
      "minLength": 1
    },
    "license_status": {
      "type": "string",
      "enum": ["documented", "licensed", "public_domain", "cc0", "unknown"]
    },
    "publish_allowed": {
      "type": "boolean"
    },
    "license_scope": {
      "type": "string",
      "minLength": 1
    },
    "license_notes": {
      "type": "string",
      "minLength": 1
    },
    "allowed_uses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "disallowed_uses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
