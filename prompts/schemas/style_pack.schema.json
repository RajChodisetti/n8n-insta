{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://n8n-insta.local/prompts/schemas/style_pack.schema.json",
  "title": "AI Video Style Pack Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "last_reviewed", "status", "style_packs"],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "last_reviewed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "type": "string",
      "enum": ["contract_assets_only_not_runtime_loaded", "runtime_loaded"]
    },
    "style_packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "file",
          "best_use",
          "poor_use",
          "pacing",
          "visuals",
          "captions",
          "transitions",
          "music",
          "sfx",
          "voice",
          "avatar_policy",
          "template_needs",
          "negative_rules",
          "rule_sets"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "pattern": "^[a-z0-9_]+\\.md$"
          },
          "best_use": {
            "type": "string",
            "minLength": 1
          },
          "poor_use": {
            "type": "string",
            "minLength": 1
          },
          "pacing": {
            "type": "string",
            "minLength": 1
          },
          "visuals": {
            "type": "string",
            "minLength": 1
          },
          "captions": {
            "type": "string",
            "minLength": 1
          },
          "transitions": {
            "type": "string",
            "minLength": 1
          },
          "music": {
            "type": "string",
            "minLength": 1
          },
          "sfx": {
            "type": "string",
            "minLength": 1
          },
          "voice": {
            "type": "string",
            "minLength": 1
          },
          "avatar_policy": {
            "type": "string",
            "minLength": 1
          },
          "template_needs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "negative_rules": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rule_sets": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "brand_safety",
                "visual_consistency",
                "voice",
                "music_sfx",
                "avatar",
                "editing",
                "provider_routing",
                "platform_publishing",
                "approval"
              ]
            }
          }
        }
      }
    }
  }
}
