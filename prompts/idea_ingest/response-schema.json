{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "category",
    "confidence_label",
    "target_duration_seconds",
    "summary",
    "notes",
    "source_urls",
    "context",
    "creative_defaults"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "confidence_label": {
      "type": "string",
      "enum": ["unverified", "legend", "disputed", "likely", "confirmed"]
    },
    "target_duration_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "context": {
      "type": "string"
    },
    "creative_defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "narrative_perspective",
        "voice_role_hint",
        "tone",
        "narrator_style",
        "visual_strategy",
        "pacing_strategy",
        "mood_curve",
        "energy_curve",
        "music_mood",
        "avoid_rules"
      ],
      "properties": {
        "narrative_perspective": {
          "type": "string",
          "minLength": 1
        },
        "voice_role_hint": {
          "type": "string",
          "minLength": 1
        },
        "tone": {
          "type": "string",
          "minLength": 1
        },
        "narrator_style": {
          "type": "string",
          "minLength": 1
        },
        "visual_strategy": {
          "type": "string",
          "minLength": 1
        },
        "pacing_strategy": {
          "type": "string",
          "minLength": 1
        },
        "mood_curve": {
          "type": "string",
          "minLength": 1
        },
        "energy_curve": {
          "type": "string",
          "minLength": 1
        },
        "music_mood": {
          "type": "string",
          "minLength": 1
        },
        "avoid_rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
