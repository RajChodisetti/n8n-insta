    "music_direction": { "type": "string" },
    "onscreen_text_json": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scene_number", "text"],
        "properties": {
          "scene_number": { "type": "integer", "minimum": 1 },
          "text": { "type": "string" }
        }
      }
    },
    "scene_guidance_json": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scene_number", "beat_label", "start_time_seconds", "end_time_seconds", "duration_seconds", "narration_text", "dialogue_lines", "asset_type", "asset_plan", "remotion", "image_prompt", "music_cue", "tts_instructions", "includes_primary_character"],
        "properties": {
          "scene_number": { "type": "integer", "minimum": 1 },
          "beat_label": { "type": "string" },
          "start_time_seconds": { "type": "number", "minimum": 0 },
          "end_time_seconds": { "type": "number", "exclusiveMinimum": 0 },
          "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
          "narration_text": { "type": "string" },
          "dialogue_lines": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "asset_type": { "type": "string", "enum": ["image", "video"] },
          "asset_plan": {
            "type": "object",
