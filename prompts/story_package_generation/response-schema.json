      "required": ["core_angle", "point_of_view", "emotional_arc", "narration_strategy", "visual_strategy", "music_strategy", "consistency_rules"],
      "properties": {
        "core_angle": { "type": "string" },
        "point_of_view": { "type": "string" },
        "emotional_arc": { "type": "string" },
        "narration_strategy": { "type": "string" },
        "visual_strategy": { "type": "string" },
        "music_strategy": { "type": "string" },
        "consistency_rules": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "confidence_label": { "type": "string" },
    "hook_option_1": { "type": "string" },
    "hook_option_2": { "type": "string" },
    "hook_option_3": { "type": "string" },
    "selected_hook": { "type": "string" },
    "narration_script": { "type": "string" },
    "short_script": { "type": "string" },
    "caption_draft": { "type": "string" },
