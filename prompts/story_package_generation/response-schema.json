      "type": "object",
      "additionalProperties": false,
      "required": ["output", "timeline", "subtitles"],
      "properties": {
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height", "fps", "format"],
          "properties": {
            "width": { "type": "integer" },
            "height": { "type": "integer" },
            "fps": { "type": "integer" },
            "format": { "type": "string" }
