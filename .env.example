# Copy to the repo-root `.env` and fill with real values locally.
# Never commit real API tokens.
INSTAGRAM_GRAPH_API_TOKEN=
SHORT_LIVED_INSTAGRAM_GRAPH_API_TOKEN=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GRAPH_API_VERSION=v25.0
STUDIO_UI_HOST_PORT=7780
STUDIO_TOPIC_TARGET_DURATION_MIN_SECONDS=15
STUDIO_TOPIC_TARGET_DURATION_MAX_SECONDS=180
STUDIO_TOPIC_TARGET_DURATION_DEFAULT_SECONDS=45

CONTENT_LANGUAGE=English

RESEARCH_LANGUAGE=
STORYBOARD_LANGUAGE=
CAPTION_LANGUAGE=
SCENE_IMAGE_LANGUAGE=
NARRATION_LANGUAGE=
POST_IMAGE_LANGUAGE=

# Explicit safety switch for live Instagram publishing from n8n.
INSTAGRAM_PUBLISH_ENABLED=false
PG_CREDENTIAL_NAME=Postgres account

# Adapter selectors. These are the primary knobs to swap providers and models
# per workflow component without editing workflow JSON.
TEXT_LLM_PROVIDER=openai
RESEARCH_LLM_PROVIDER=
STORYBOARD_LLM_PROVIDER=
CAPTION_LLM_PROVIDER=

IMAGE_GENERATION_PROVIDER=openai
SCENE_IMAGE_PROVIDER=
SCENE_REFERENCE_IMAGE_PROVIDER=openai
POST_IMAGE_PROVIDER=

TTS_PROVIDER=openai
NARRATION_PROVIDER=

RENDER_PROVIDER=local_ffmpeg

ASSET_HOST_PROVIDER=google_cloud_storage
SCENE_IMAGE_HOST_PROVIDER=
POST_IMAGE_HOST_PROVIDER=
NARRATION_HOST_PROVIDER=
RENDER_OUTPUT_HOST_PROVIDER=

# Current host implementations:
# - `object_storage` for MinIO/S3-compatible delivery
# - `google_cloud_storage` for Google Cloud Storage public object delivery

# Legacy asset-host fallback. Keep this only for backward compatibility.
IMAGE_HOST_PROVIDER=
GOOGLE_CLOUD_STORAGE_BUCKET=
GOOGLE_CLOUD_STORAGE_SERVICE_ACCOUNT_KEY_PATH=/secrets/google/sa-key.json
GOOGLE_CLOUD_STORAGE_ENDPOINT=https://storage.googleapis.com
GOOGLE_CLOUD_STORAGE_PUBLIC_BASE_URL=https://storage.googleapis.com

# Public base URL for the generic object-storage adapter.
REELS_STORAGE_PUBLIC_BASE_URL=
REELS_STORAGE_KEY_PREFIX=generated/instagram-posts

# Generic model selectors.
# TEXT_MODEL is the default fallback for all stages.
# Stage-specific vars take priority over TEXT_MODEL.
TEXT_MODEL=gpt-4.1-mini
DIRECTOR_MODEL=gpt-4.1
RESEARCH_MODEL=gpt-4.1
STORYBOARD_MODEL=gpt-4.1
PROMPT_BUILDER_MODEL=gpt-4.1-mini
PREMIUM_TEXT_MODEL=gpt-4.1
STORY_PACKAGE_MODEL=gpt-4.1

RESEARCH_BRAND_TONE=cinematic, concise, credible
RESEARCH_NARRATOR_STYLE=calm, serious, engaging
RESEARCH_ENDING_SIGNATURE_FAMILY=thought-provoking close
RESEARCH_TIMING_GUIDANCE=

STORYBOARD_BRAND_TONE=cinematic, concise, credible
STORYBOARD_VISUAL_STYLE_RULES=dark, atmospheric, documentary-realistic, moody lighting, strong focal point, no visible text
STORYBOARD_SUBTITLE_STYLE_RULES=short lines, centered safe zone, high contrast, mobile readable
STORYBOARD_TIMING_GUIDANCE=
STORYBOARD_NARRATION_ALIGNMENT_GUIDANCE=
STORYBOARD_RENDER_TIMING_GUIDANCE=

CAPTION_BRAND_TONE=cinematic, concise, credible
CAPTION_LANGUAGE_GUIDANCE=
SCENE_STYLE_NOTES_DEFAULT=cinematic, moody, realistic, vertical-frame storytelling
SCENE_IMAGE_TIMING_GUIDANCE=
SCENE_IMAGE_STORY_ALIGNMENT_GUIDANCE=
POST_IMAGE_COVER_PROMPT_DIRECTION_DEFAULT=Use a cinematic mystery-documentary composition.
POST_IMAGE_STYLE_NOTES_DEFAULT=dark, atmospheric, realistic, cinematic lighting, deep blues, blacks, shadows, mystery and intrigue.
POST_IMAGE_STORY_ALIGNMENT_GUIDANCE=

IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1024x1024
IMAGE_QUALITY=medium
IMAGE_COMPRESSION=92
IMAGE_STYLE=natural

SCENE_IMAGE_MODEL=
SCENE_REFERENCE_IMAGE_MODEL=gpt-image-1
SCENE_IMAGE_SIZE=1024x1536
SCENE_IMAGE_QUALITY=
SCENE_IMAGE_COMPRESSION=90

POST_IMAGE_MODEL=
POST_IMAGE_SIZE=
POST_IMAGE_QUALITY=
POST_IMAGE_COMPRESSION=
POST_IMAGE_STYLE=

TTS_MODEL=s2-pro
TTS_VOICE=
TTS_INSTRUCTIONS=

NARRATION_MODEL=
NARRATION_VOICE=
NARRATION_INSTRUCTIONS=
NARRATION_TIMING_GUIDANCE=

# Fish Audio — model and per-role voice reference_ids.
# Set TTS_PROVIDER=fish_audio to activate.
# FISH_AUDIO_TTS_MODEL controls which Fish Audio engine is used (s2-pro recommended).
# Each voice role maps to a reference_id (Fish Audio voice clone ID).
# If a role-specific var is blank, it falls back to the gender-bucket default,
# then to the bare FISH_AUDIO_REFERENCE_ID / FISH_AUDIO_REFERENCE_ID_FEMALE.
FISH_AUDIO_API_KEY=
FISH_AUDIO_TTS_MODEL=s2-pro
FISH_AUDIO_TEMPERATURE=0.85
FISH_AUDIO_TOP_P=0.85
FISH_AUDIO_REFERENCE_ID=
FISH_AUDIO_REFERENCE_ID_FEMALE=
FISH_AUDIO_VOICE_PRIMARY_MALE=
FISH_AUDIO_VOICE_INVESTIGATIVE_MALE=
FISH_AUDIO_VOICE_URGENT_MALE=
FISH_AUDIO_VOICE_DOCUMENTARY_NARRATOR=
FISH_AUDIO_VOICE_PRIMARY_FEMALE=
FISH_AUDIO_VOICE_CALM_FEMALE=

# Legacy OpenAI-specific fallback envs. These remain supported so older local
# setups keep working while the repo migrates to adapter-first selectors.
# Existing local setups that still use LLL_API_KEY are also supported.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_RESEARCH_MODEL=
OPENAI_STORYBOARD_MODEL=
OPENAI_CAPTION_MODEL=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=
OPENAI_IMAGE_QUALITY=
OPENAI_IMAGE_COMPRESSION=
OPENAI_IMAGE_STYLE=
OPENAI_SCENE_IMAGE_MODEL=
OPENAI_SCENE_IMAGE_SIZE=
OPENAI_SCENE_IMAGE_QUALITY=
OPENAI_SCENE_IMAGE_COMPRESSION=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=onyx
OPENAI_TTS_INSTRUCTIONS=
# Optional prompt root override. Docker mounts the repo prompt files at `/prompts`
# and the workflow helper scripts load prompt assets from there by default.
PROMPTS_ROOT=/prompts
RENDER_OUTPUT_WIDTH=1080
RENDER_OUTPUT_HEIGHT=1920
RENDER_OUTPUT_FPS=30
RENDER_OUTPUT_FORMAT=mp4
RENDER_SUBTITLE_STYLE=cinematic_center_safe
RENDER_TIMELINE_MODE=fit_to_narration
RENDER_SCENE_MIN_SECONDS=2.5
RENDER_WORKER_MODE=stub
RENDER_WORKER_URL=
RENDER_WORKER_SYNC_URL=http://render-worker:8080/render-sync
RENDER_CALLBACK_URL=http://n8n:5678/webhook/render-status-callback
RENDER_OUTPUT_PATH_PREFIX=reels
RENDER_WAIT_SECONDS=300
RENDER_WAIT_POLL_SECONDS=5
INSTAGRAM_INSIGHTS_COLLECTION_MODE=stub
INSTAGRAM_INSIGHTS_MEDIA_METRICS=views,reach,saved,shares,plays
