# Copy to the repo-root `.env` and fill with real values locally.
# Never commit real API tokens.
INSTAGRAM_GRAPH_API_TOKEN=
GRAPH_API_VERSION=v25.0

# Explicit safety switch for live Instagram publishing from n8n.
INSTAGRAM_PUBLISH_ENABLED=false

# Generated-image delivery host.
# Set `IMAGE_HOST_PROVIDER=imagekit` to upload generated JPEG assets to ImageKit
# and persist the public `ik.imagekit.io/...` URL as the Instagram delivery URL.
# Leave it empty or set `object_storage` to keep using MinIO/S3 delivery, in
# which case `REELS_STORAGE_PUBLIC_BASE_URL` must be a Meta-reachable public URL.
IMAGE_HOST_PROVIDER=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_UPLOAD_PATH=
IMAGEKIT_PRIVATE_KEY=

# Public base URL for object-storage delivery when `IMAGE_HOST_PROVIDER` is not
# `imagekit`.
REELS_STORAGE_PUBLIC_BASE_URL=
REELS_STORAGE_KEY_PREFIX=generated/instagram-posts

# OpenAI-backed Phase 2 workflows prefer OPENAI_API_KEY.
# Existing local setups that still use LLL_API_KEY are also supported.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_RESEARCH_MODEL=
OPENAI_STORYBOARD_MODEL=
OPENAI_CAPTION_MODEL=
OPENAI_HASHTAG_MODEL=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_COMPRESSION=92
OPENAI_IMAGE_STYLE=natural
